{
  "functions": [
    {
      "source": "apps/api",
      "codebase": "damaged-code-api",
      "runtime": "nodejs22",
      "ignore": [
        ".git",
        ".gitignore",
        "node_modules",
        "src",
        "coverage",
        "*.log"
      ],
      "predeploy": ["pnpm --filter @damaged-code/api build"]
    }
  ],
  "hosting": [
    {
      "target": "damaged-code-web",
      "public": "apps/web/public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "damaged-code-web",
            "region": "us-central1"
          }
        }
      ]
    }
  ]
}
