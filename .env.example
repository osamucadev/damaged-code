# Published host ports for the local Docker environment.
#
# Only the host side is configurable. Ports inside the Compose network are
# fixed, and services always reach each other through service DNS and those
# internal ports, never through the published ports below.
#
# Copy this file to .env to override the defaults.

WEB_HOST_PORT=17320
API_HOST_PORT=17321
STORYBOOK_HOST_PORT=17322
FIREBASE_UI_HOST_PORT=17323
FIRESTORE_HOST_PORT=17324
