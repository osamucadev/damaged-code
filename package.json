{
  "name": "damaged-code",
  "version": "0.0.0",
  "private": true,
  "description": "Damaged Code: a Rick and Morty coding challenge",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:docker": "docker compose up --build",
    "dev:docker:down": "docker compose down",
    "storybook": "pnpm --filter @damaged-code/web storybook",
    "build-storybook": "pnpm --filter @damaged-code/web build-storybook",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "firebase-tools": "15.30.2"
  }
}
